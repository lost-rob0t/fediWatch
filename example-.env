FEDIWATCH_TRANSPORT=http
FEDIWATCH_POLL_INTERVAL_SECONDS=60
FEDIWATCH_BATCH_SIZE=500
FEDIWATCH_EMIT_RETRIES=3
FEDIWATCH_ONCE=false

STAR_DATASET=fediverse
STARINTEL_HTTP_URL=http://127.0.0.1:5000
# STARINTEL_HTTP_BULK_URL=http://127.0.0.1:5000/documents/bulk
# STARINTEL_HTTP_TOKEN=

# For RabbitMQ output:
# FEDIWATCH_TRANSPORT=rabbitmq
# STARINTEL_RABBITMQ_URL=amqp://guest:guest@127.0.0.1/
# STARINTEL_RABBITMQ_EXCHANGE=documents
# STARINTEL_RABBITMQ_ROUTING_PREFIX=documents.ingest

# Configure one target source:
FEDIWATCH_TARGETS=[{"target":"https://mastodon.social","dataset":"fediverse","options":{"type":"instance","local":true,"limit":40}}]
# FEDIWATCH_TARGETS_FILE=/etc/fediwatch/targets.json
# FEDIWATCH_TARGETS_URL=http://127.0.0.1:5000/targets/fediwatch

# Optional strict schema validation:
# STARINTEL_SCHEMA=/etc/starintel/starintel-doc-v0.9.0.schema.json
# FEDIWATCH_LOG=/var/log/fediwatch.log
